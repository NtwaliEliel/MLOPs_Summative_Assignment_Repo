{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "dockerfilePath": "api/Dockerfile",
        "context": "."
    },
    "deploy": {
        "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
        "healthCheckPath": "/health",
        "restartPolicyType": "ON_FAILURE"
    }
}